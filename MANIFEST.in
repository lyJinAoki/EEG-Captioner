include README.md LICENSE NOTICE .gitignore constraints-tested.txt
recursive-include configs *.yaml
recursive-include docs *.md *.json
recursive-include scripts *.sh
recursive-include tests *.py
recursive-include .github *.yml
prune local
prune data
prune checkpoints
prune runs
prune .venv
global-exclude __pycache__ *.py[cod] *.pt *.pth *.safetensors *.h5 *.edf
